<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.greetingsystem.ui.DetailsController"
      spacing="12" styleClass="screen">
    <Label text="Your details" styleClass="title"/>
    <Label text="Enter your name, age, and time of day." styleClass="subtitle"/>

    <Label text="Name"/>
    <TextField fx:id="nameField" promptText="Full name"/>

    <Label text="Age"/>
    <TextField fx:id="ageField" promptText="Years"/>

    <Label text="Time of day"/>
    <fx:define>
        <ToggleGroup fx:id="timeOfDayGroup"/>
    </fx:define>
    <HBox spacing="16">
        <RadioButton fx:id="amRadio" text="AM" toggleGroup="$timeOfDayGroup"/>
        <RadioButton fx:id="pmRadio" text="PM" toggleGroup="$timeOfDayGroup"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="error"/>

    <HBox spacing="12">
        <Button text="Back" onAction="#onBack" cancelButton="true"/>
        <Button text="Continue" onAction="#onSubmit" defaultButton="true"/>
    </HBox>
</VBox>
